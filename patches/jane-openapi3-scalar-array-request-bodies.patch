+    private function isScalarArraySchema(?Schema $schema): bool
+    {
+        if (!$schema instanceof Schema || 'array' !== $schema->getType()) {
+            return false;
+        }
+
+        $items = $schema->getItems();
+
+        if (!$items instanceof Schema) {
+            return false;
+        }
+
+        return \in_array($items->getType(), ['string', 'number', 'boolean', 'integer'], true);
+    }

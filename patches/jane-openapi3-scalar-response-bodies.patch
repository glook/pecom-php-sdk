+    private function getOneOfResponseBranches($schema, string $reference, GuessClass $guessClass, Context $context): array
+    {
+        if (!$schema instanceof Schema || true === $schema->getNullable()) {
+            return [];
+        }
+
+        $oneOf = $schema->getOneOf();
+
+        if (!\is_array($oneOf) || \count($oneOf) < 2) {
+            return [];
+        }
+
+        $branches = [];
+
+        foreach ($oneOf as $index => $branchSchema) {
+            $branchReference = $reference . '/oneOf/' . $index;
+            $classGuess = $guessClass->guessClass($branchSchema, $branchReference, $context->getRegistry(), $array);
+
+            if (null === $classGuess || !$branchSchema instanceof Schema) {
+                return [];
+            }
+
+            $class = $context->getRegistry()->getSchema($classGuess->getReference())->getNamespace() . '\\Model\\' . $classGuess->getName();
+
+            if ($array) {
+                $class .= '[]';
+            }
+
+            $branches[] = [
+                'class' => $class,
+                'returnType' => '\\' . $class,
+                'schema' => $branchSchema,
+                'reference' => $branchReference,
+            ];
+        }
+
+        return $branches;
+    }
+
+    private function createOneOfResponseStatements(array $branches, GuessClass $guessClass, Context $context): array
+    {
+        $decodedBody = new Expr\Variable($context->getUniqueVariableName('decodedBody'));
+        $matchingTypes = new Expr\Variable($context->getUniqueVariableName('matchingTypes'));
+        $statements = [
+            new Stmt\Expression(new Expr\Assign(
+                $decodedBody,
+                new Expr\FuncCall(new Name('json_decode'), [new Node\Arg(new Expr\Variable('body'))])
+            )),
+            new Stmt\Expression(new Expr\Assign($matchingTypes, new Expr\Array_())),
+        ];
+
+        foreach ($branches as $branch) {
+            $statements[] = new Stmt\If_(
+                $this->createSchemaMatchCondition($branch['schema'], $decodedBody, $branch['reference'], $guessClass, $context),
+                [
+                    'stmts' => [new Stmt\Expression(new Expr\Assign(
+                        new Expr\ArrayDimFetch($matchingTypes),
+                        new Scalar\String_($branch['class'])
+                    ))],
+                ]
+            );
+        }
+
+        $exception = new Expr\New_(
+            new Name\FullyQualified(\UnexpectedValueException::class),
+            [new Node\Arg(new Scalar\String_('Ответ API должен соответствовать ровно одной схеме oneOf'))]
+        );
+        $statements[] = new Stmt\If_(
+            new Expr\BinaryOp\NotIdentical(
+                new Scalar\LNumber(1),
+                new Expr\FuncCall(new Name('count'), [new Node\Arg($matchingTypes)])
+            ),
+            ['stmts' => [new Stmt\Throw_($exception)]]
+        );
+
+        foreach ($branches as $branch) {
+            $statements[] = new Stmt\If_(
+                new Expr\BinaryOp\Identical(
+                    new Expr\ArrayDimFetch($matchingTypes, new Scalar\LNumber(0)),
+                    new Scalar\String_($branch['class'])
+                ),
+                [
+                    'stmts' => [new Stmt\Return_(new Expr\MethodCall(
+                        new Expr\Variable('serializer'),
+                        'deserialize',
+                        [
+                            new Node\Arg(new Expr\Variable('body')),
+                            new Node\Arg(new Scalar\String_($branch['class'])),
+                            new Node\Arg(new Scalar\String_('json')),
+                        ]
+                    ))],
+                ]
+            );
+        }
+
+        $statements[] = new Stmt\Throw_($exception);
+
+        return $statements;
@@ -301,0 +451,101 @@
+
+    private function createSchemaMatchCondition($schema, Expr $input, string $reference, GuessClass $guessClass, Context $context): Expr
+    {
+        if ($schema instanceof Reference) {
+            [$reference, $schema] = $guessClass->resolve($schema, Schema::class);
+        }
+
+        if (!$schema instanceof Schema) {
+            return new Expr\ConstFetch(new Name('false'));
+        }
+
+        $type = $schema->getType();
+
+        if ('array' === $type) {
+            $item = new Expr\Variable($context->getUniqueVariableName('item'));
+            $itemCondition = $this->createSchemaMatchCondition($schema->getItems(), $item, $reference . '/items', $guessClass, $context);
+            $condition = new Expr\BinaryOp\BooleanAnd(
+                new Expr\FuncCall(new Name('is_array'), [new Node\Arg($input)]),
+                new Expr\BooleanNot(new Expr\FuncCall(new Name('array_filter'), [
+                    new Node\Arg($input),
+                    new Node\Arg(new Expr\Closure([
+                        'params' => [new Node\Param($item)],
+                        'stmts' => [new Stmt\Return_(new Expr\BooleanNot($itemCondition))],
+                    ])),
+                ]))
+            );
+        } elseif ('object' === $type || $schema->getProperties()) {
+            $condition = new Expr\FuncCall(new Name('is_object'), [new Node\Arg($input)]);
+            $required = $schema->getRequired() ?: [];
+
+            foreach ($schema->getProperties() ?: [] as $propertyName => $propertySchema) {
+                $propertyExists = new Expr\FuncCall(new Name('property_exists'), [
+                    new Node\Arg($input),
+                    new Node\Arg(new Scalar\String_($propertyName)),
+                ]);
+                $propertyCondition = $this->createSchemaMatchCondition(
+                    $propertySchema,
+                    new Expr\PropertyFetch($input, new Scalar\String_($propertyName)),
+                    $reference . '/properties/' . $propertyName,
+                    $guessClass,
+                    $context
+                );
+
+                if (\in_array($propertyName, $required, true)) {
+                    $propertyCondition = new Expr\BinaryOp\BooleanAnd($propertyExists, $propertyCondition);
+                } else {
+                    $propertyCondition = new Expr\BinaryOp\BooleanOr(new Expr\BooleanNot($propertyExists), $propertyCondition);
+                }
+
+                $condition = new Expr\BinaryOp\BooleanAnd($condition, $propertyCondition);
+            }
+        } elseif ('string' === $type) {
+            $condition = new Expr\FuncCall(new Name('is_string'), [new Node\Arg($input)]);
+        } elseif ('integer' === $type) {
+            $condition = new Expr\FuncCall(new Name('is_int'), [new Node\Arg($input)]);
+        } elseif ('number' === $type) {
+            $condition = new Expr\BinaryOp\BooleanOr(
+                new Expr\FuncCall(new Name('is_int'), [new Node\Arg($input)]),
+                new Expr\FuncCall(new Name('is_float'), [new Node\Arg($input)])
+            );
+        } elseif ('boolean' === $type) {
+            $condition = new Expr\FuncCall(new Name('is_bool'), [new Node\Arg($input)]);
+        } elseif ('null' === $type) {
+            $condition = new Expr\FuncCall(new Name('is_null'), [new Node\Arg($input)]);
+        } else {
+            $condition = new Expr\ConstFetch(new Name('false'));
+        }
+
+        if (true === $schema->getNullable()) {
+            return new Expr\BinaryOp\BooleanOr(
+                new Expr\FuncCall(new Name('is_null'), [new Node\Arg($input)]),
+                $condition
+            );
+        }
+
+        return $condition;
+    }
+
+    private function getScalarResponseType($schema): ?string
+    {
+        if (!$schema instanceof Schema || true === $schema->getNullable()) {
+            return null;
+        }
+
+        if ('string' === $schema->getType()) {
+            return 'string';
+        }
+
+        $items = $schema->getItems();
+
+        if ('array' === $schema->getType() && $items instanceof Schema && true !== $items->getNullable() && 'string' === $items->getType()) {
+            return 'string[]';
+        }
+
+        return null;
+    }
+
+    private function isInferredResponseType(string $type): bool
+    {
+        return 'string' === $type || 'string[]' === $type || false !== strpos($type, '|');
+    }
